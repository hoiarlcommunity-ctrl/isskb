*.mbtiles
venv
.venv314
*.pyc
.claude/
*.log
__pycache__/
# Стандартные виртуальные окружения
venv/
ENV/

# Окружения, созданные через virtualenvwrapper (обычно вне проекта, но на всякий случай)
.virtualenvs/

# Pipenv (если создаёте окружение внутри проекта — бывает реже)
.venv/

# Poetry (по умолчанию создаёт .venv, уже есть выше)
# PDM (использует __pypackages__)
__pypackages__/

# Conda / Miniconda (если вдруг окружение лежит внутри проекта)
.conda/
condaenv/

# Обобщённый шаблон: любые папки, заканчивающиеся на env/ (осторожно, может задеть не то)
# *env/
# !.env.example  # если используете файлы .env для переменных окружения, их лучше не игнорировать
